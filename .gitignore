# Secrets - the agent's Gemini key lives here. Never commit.
.env
*.env
!.env.example

# Service account keys
*-key.json
service-account*.json

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# ADK local state (sessions, artifacts)
.adk/

# Node
node_modules/

# The UI standardises on pnpm. Netlify picks its package manager from whichever
# lockfile it finds and installs with --frozen-lockfile, so a stray
# package-lock.json from `npm install` desyncs from the lockfile CI actually
# reads and the deploy fails with ERR_PNPM_OUTDATED_LOCKFILE.
package-lock.json
yarn.lock

# OS
.DS_Store
Thumbs.db

# Local Netlify folder
.netlify
